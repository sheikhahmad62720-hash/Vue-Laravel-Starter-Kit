{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "laravel-vue-starter-kit",
    "description": "A minimal Laravel 13, Vue 3, Inertia, and TypeScript starter kit.",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node ./node_modules/vite/bin/vite.js",
        "build": "node ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit && node ./node_modules/vite/bin/vite.js build",
        "type-check": "node ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "vite": "^7.0.7",
        "vue-tsc": "^3.3.14"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.9.1",
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.7.0",
        "vue": "^3.5.44"
    }
}
